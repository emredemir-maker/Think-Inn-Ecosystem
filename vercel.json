{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm install --frozen-lockfile --filter '@workspace/think-inn...' && pnpm --filter @workspace/think-inn run build",
  "installCommand": "echo 'install handled in buildCommand'",
  "outputDirectory": "artifacts/think-inn/dist/public",
  "framework": null,
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
